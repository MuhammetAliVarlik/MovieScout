# TMDB API — free account at themoviedb.org/settings/api
# Leave blank to use only the local TMDB dataset (no live enrichment).
# Any non-empty value here is treated as a real key and used for live
# lookups, so don't put a placeholder string in — leave it empty.
TMDB_API_KEY=

SECRET_KEY=change-this-to-any-random-string
FLASK_ENV=development

# Local TMDB dataset path (Kaggle CSV already used by the project)
TMDB_DATASET_PATH=./data/processed/TMDB.csv

# ChromaDB vector store — persisted locally on disk
CHROMA_PERSIST_PATH=./data/chroma

# Local LLM chat — powered by Ollama (https://ollama.com).
# Install Ollama, then run: ollama pull llama3.2:3b
# Not required for search/discover/recommendations/Letterboxd import —
# only the /chat page needs it.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LOCAL_MODEL_MAX_TOKENS=512

MAX_RECOMMENDATIONS=20
RAG_CONTEXT_FILMS=10
