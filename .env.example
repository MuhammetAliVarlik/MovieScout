# TMDB API — free account at themoviedb.org/settings/api
# Required to run scripts/build_dataset.py (or scripts/setup.py) — MovieScout
# doesn't ship a bundled dataset (TMDB's terms don't allow redistributing
# their data), so you fetch your own bounded, popularity-ranked subset.
# Optional for the app itself: it's also used, if set, as a live per-title
# fallback when importing a Letterboxd export finds a film missing from your
# local dataset. Leave blank to skip that fallback.
TMDB_API_KEY=

# How many of TMDB's most popular movies scripts/build_dataset.py fetches.
TMDB_BUILD_LIMIT=20000

SECRET_KEY=change-this-to-any-random-string
FLASK_ENV=development

# Local dataset path — built by scripts/build_dataset.py, not shipped
TMDB_DATASET_PATH=./data/processed/TMDB.csv

# ChromaDB vector store — persisted locally on disk
CHROMA_PERSIST_PATH=./data/chroma

# Local LLM chat — powered by Ollama (https://ollama.com).
# Install Ollama, then run: ollama pull llama3.2:3b
# Not required for search/discover/recommendations/Letterboxd import —
# only the /chat page needs it.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LOCAL_MODEL_MAX_TOKENS=512

MAX_RECOMMENDATIONS=20
RAG_CONTEXT_FILMS=10
